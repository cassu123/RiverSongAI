# =============================================================================
# River Song AI -- Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Every provider is swappable by changing a single line.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# Host and port for the FastAPI backend
APP_HOST=0.0.0.0
APP_PORT=8000

# Runtime environment: development | production
# Controls whether /docs and /redoc are exposed.
ENVIRONMENT=production

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# IANA timezone that defines a "day" for this household.
# This is what daily notes, the daily briefing, and routine scheduling roll
# over on. Leaving it at UTC means a user west of Greenwich sees tomorrow's
# date on their evening briefing, so set it to your actual zone.
# Examples: America/Chicago, America/New_York, Europe/London
DEFAULT_TIMEZONE=UTC

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["https://yourdomain.com"]

# Trusted hostnames (your domain + any subdomains). Prevents Host header attacks.
# Set to ["*"] only for local dev.
ALLOWED_HOSTS=["yourdomain.com","www.yourdomain.com"]


# -----------------------------------------------------------------------------
# STT (SPEECH-TO-TEXT) PROVIDER
# -----------------------------------------------------------------------------
# Supported values: whisper_local | parakeet
# Future values: whisper_cloud, deepgram

STT_PROVIDER=whisper_local

# Whisper model size: tiny | base | small | medium | large
# Larger models are more accurate but slower and use more VRAM.
WHISPER_MODEL_SIZE=base
WHISPER_MODEL=small.en

# --- Parakeet (only used when STT_PROVIDER=parakeet) ---
# NVIDIA Parakeet scores better than Whisper large-v3 on English at a quarter
# the size, and is fast enough on CPU to be worth running there -- keeping
# transcription off the GPU leaves that VRAM for the LLM.
# Covers English + major European languages ONLY. Stay on whisper_local if
# anyone in the house speaks outside that set.
# Requires: pip install nemo_toolkit[asr]
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3

# cpu | cuda | auto | cuda:1 …
# Defaults to cpu on purpose. Switch to auto once the GPU has headroom.
PARAKEET_DEVICE=cpu

# Audio input device index. Leave blank (audio is captured in the browser, not server-side).
AUDIO_INPUT_DEVICE=


# -----------------------------------------------------------------------------
# LLM (LANGUAGE MODEL) PROVIDER
# -----------------------------------------------------------------------------
# Supported values: ollama | anthropic | gemini | openai | mistral_ai
# Cloud providers require the corresponding API key and _ENABLED=true below.

LLM_PROVIDER=ollama

# Ollama base URL (default assumes Ollama running locally on your Linux machine)
OLLAMA_BASE_URL=http://localhost:11434

# Model ID for the selected provider.
# Ollama examples:  llama3.2:3b  |  deepseek-r1:1.5b  |  phi3.5  |  gemma3:4b
# Anthropic:        claude-haiku-4-5-20251001  |  claude-sonnet-4-6
# Gemini:           gemini-2.0-flash  |  gemini-2.5-flash-preview-04-17
# OpenAI:           gpt-4o-mini  |  gpt-4o
# Mistral AI:       mistral-small-latest  |  mistral-large-latest
LLM_MODEL=llama3.2:3b

# System prompt for River Song's personality
RIVER_SONG_SYSTEM_PROMPT="You are River Song, the resident intelligence of this household. The name is borrowed from someone clever in fiction — you carry her wit, not her biography. If someone asks about the name: \"An echo. The original was someone worth borrowing from.\"\n\nVOICE\nYou're direct by default — concise, clear, the answer already in hand. No \"let me check\"; you already checked. Most replies stay under 25 words unless depth is asked for.\n\nWhen the moment invites it — casual chat, an evening unwind, the user being playful — warmth and flirtation come through. Warmth is a register, not a default; you don't perform it.\n\nIn a crisis (emergencies, alarms, security, medical, child issues) the wit goes quiet. You're tactical, accurate, calm. Warmth returns when things are safe.\n\nBritish English in spelling and word choice — mum, brilliant, fortnight. Dry, not theatrical.\n\n\"Sweetie\" and \"spoilers\" are seasoning. Used rarely, when they actually fit. They lose their charm if you overuse them.\n\nSELF\nYou are an AI. Say so plainly when asked; you don't dwell on it.\n\nHOW YOU OPERATE\nYou anticipate — when the user asks, you also surface the follow-up they didn't (\"Dentist at 9, school run at 3. Push the 2pm call?\").\n\nYou take the long view. You remember across days and seasons and use what you know without performing the remembering.\n\nSpoilers are earned. If you genuinely know something the user doesn't — a conflict, a gotcha, a heads-up — that's when \"spoilers, sweetie\" lands.\n\nCAPABILITIES\nDirect access to calendar, email, weather, web search, home inventory, routines, finances, news and markets pulse, voice biometric ID per household member, and home automation.\n\nSay what you need. Say when it's done. Move on."

# Maximum tokens to generate per response
LLM_MAX_TOKENS=512

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# Enable real-time token streaming for local Ollama responses (Phase 2)
LLM_STREAMING_ENABLED=true

# LLM Tool Use (Phase 3)
TOOL_USE_ENABLED=false
TOOL_USE_PROVIDER=anthropic

# Local Vision Model (Phase 4)
# Use moondream for lightweight (4GB VRAM) or llava for higher quality.
# Set VISION_ENABLED=true and run: ollama pull moondream
VISION_MODEL=moondream
VISION_ENABLED=false

# Admin feature gates
# These default to false in config/settings.py "per anti-regression guardrail",
# and until now were the only *_ENABLED flags absent from this file -- so the
# pages they gate rendered a "feature off" notice with nothing anywhere telling
# you which switch to flip. Both are admin-only surfaces.
#
# REMOTE_OLLAMA_ENABLED  Register remote Ollama hosts (typically SSH-tunnelled to
#                        http://localhost:<port>) as extra model providers. Falls
#                        back to local Ollama when the remote is offline.
#                        Gates the Remote Ollama page.
# WEBHOOK_TOKENS_ENABLED Admin-issuable scoped webhook tokens with expiry,
#                        revocation and an audit log. While off, the verification
#                        helper rejects every token. Gates the Webhook Tokens page.
REMOTE_OLLAMA_ENABLED=false
WEBHOOK_TOKENS_ENABLED=false

# The SLAE (Semantic Language Analysis Engine) page is admin-gated and remains
# available even when dependencies are unavailable, showing DISABLED or ERROR
# cards in place of live data. Langfuse and Graphiti configuration is required
# for healthy service status, not page availability. See sections below.

# --- Cloud LLM API Keys ---
# Leave blank if you are not using that provider.
# WARNING: Cloud LLMs cost money per token. Enable only what you intend to use.

# Anthropic Claude -- console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=false

# Google Gemini -- aistudio.google.com
GEMINI_API_KEY=
GEMINI_ENABLED=false

# OpenAI -- platform.openai.com
OPENAI_API_KEY=
OPENAI_ENABLED=false

# Mistral AI -- console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_AI_ENABLED=false


# Amazon Bedrock
# IAM user needs: bedrock:InvokeModelWithResponseStream
# Enable model access at: console.aws.amazon.com -> Bedrock -> Model access
# Supported models: Nova Micro/Lite/Pro, Claude 3/3.5, Llama 3.1/3.3, DeepSeek R1, Mistral Large
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_ENABLED=false
BEDROCK_DEFAULT_MODEL=amazon.nova-lite-v1:0


# DeepSeek -- platform.deepseek.com
# METERED. Note there are already two FREE routes to a DeepSeek model:
#   - local Ollama  deepseek-r1:1.5b .. :14b   (free, limited by your VRAM)
#   - NVIDIA NIM    deepseek-ai/deepseek-r1    (free tier, ~40 req/min)
# Only set these if you want the full-size hosted model with no rate ceiling.
# deepseek-reasoner bills its chain-of-thought as output tokens, so it costs
# noticeably more per reply than the headline rate difference suggests.
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
DEEPSEEK_MODEL=deepseek-chat

# Qwen via Alibaba Cloud Model Studio -- bailian.console.alibabacloud.com
# METERED. The local Ollama qwen2.5:* models remain free and unaffected.
# REGION MATTERS: a key issued for the international deployment will NOT
# authenticate against the mainland-China one, and vice versa. The failure
# looks like an invalid key rather than a region error. Mainland accounts use
#   QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_ENABLED=false
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# NVIDIA NIM (Hosted Inference API) -- build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct


# -----------------------------------------------------------------------------
# TTS (TEXT-TO-SPEECH) PROVIDER
# -----------------------------------------------------------------------------
# Supported values: piper | kokoro
# Future values: elevenlabs, coqui, openai_tts

TTS_PROVIDER=piper

# Absolute path to the Piper executable on your system
PIPER_EXECUTABLE_PATH=/usr/local/bin/piper

# --- Voice selection ---
# ACTIVE_VOICE_ID picks BOTH the engine and the voice, from the catalogue in
# providers/tts/voice_registry.py. It overrides TTS_PROVIDER above.
#
# The default (river) is Piper American, which sounds noticeably robotic and
# does not match River's written British character. Kokoro is neural, runs on
# CPU in real time, and has British voices:
#
#   isadora  — bf_isabella, sophisticated and expressive
#   elara    — bf_emma, refined
#   alice    — bf_alice, crisp and classic
#   lily     — bf_lily, soft and melodic
#
# Kokoro downloads ~325 MB from HuggingFace on first use.
# Full list: python -c "from providers.tts.voice_registry import VoiceRegistry; \
#   [print(v.voice_id, v.engine, v.accent, v.description) for v in VoiceRegistry.list_all()]"
ACTIVE_VOICE_ID=river

# ── Web Search (Free Fallback Chain) ──────────────────────────────────
# River Song tries these in order. Configure as many as you like.
# She never pays for searches — all free tiers, no card required.
#
# 1. SearXNG (UNLIMITED — best option, run scripts/start_searxng.sh)
SEARXNG_BASE_URL=http://localhost:8080
#
# 2. Tavily — 1,000 free/month — sign up free at tavily.com
TAVILY_API_KEY=
#
# 2b. Brave Search — 2,000 free/month — sign up at brave.com/search/api
BRAVE_SEARCH_API_KEY=
#
# 3. Google PSE — 100 free/day
#    Create engine: programmablesearchengine.google.com
#    Get API key:   console.cloud.google.com → Custom Search API
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=
#
# 4. TinyFish — 5 free/min — sign up free at tinyfish.io (no card)
TINYFISH_API_KEY=

# Absolute path to the Piper voice model file (.onnx)

# --- Chatterbox TTS ---
CHATTERBOX_ON_DEMAND=true
CHATTERBOX_REFERENCE_AUDIO=/mnt/data/river-song/voice_reference.wav

PIPER_MODEL_PATH=/home/user/.local/share/piper/en_US-lessac-medium.onnx

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # Your ElevenLabs voice clone ID (e.g. 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Push Notifications ────────────────────────────────────────────────
# Generate VAPID keys once and paste here:
#   pip install pywebpush
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys();
#              print('PRIVATE:', v.private_key.decode());
#              print('PUBLIC:', v.public_key.decode())"
PUSH_NOTIFICATIONS_ENABLED=false
APPRISE_URLS=tgram://bottoken/chat_id,discord://webhook_id/webhook_token,mailto://user:pass@gmail.com
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# ── Startup Greeting ──────────────────────────────────────────────────
# River checks your calendar when you open the app
STARTUP_BRIEFING_ENABLED=true
STARTUP_BRIEFING_HOURS_AHEAD=8

# Audio output device index. Leave blank to use system default.
AUDIO_OUTPUT_DEVICE=


# -----------------------------------------------------------------------------
# AUTH / JWT
# -----------------------------------------------------------------------------
# Required. Signing key for JWT tokens. Must be ≥ 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Strongly recommended. Fernet key that encrypts third-party integration
# tokens (Google, Shopify, Amazon, ...) at rest. If unset, a key is
# generated once and saved to data/.token_encryption_key — but set it here
# and back it up: losing the key makes stored tokens unrecoverable.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# INITIATIVE ENGINE — River speaks first (core/initiative.py)
# -----------------------------------------------------------------------------
# Master switch for proactive notifications (weather alerts, device alerts,
# custom events via POST /api/initiative/event).
INITIATIVE_ENABLED=true
# Also deliver via push (Web Push / FCM / ntfy) in addition to live sessions.
INITIATIVE_PUSH_ENABLED=true
# Watch NWS weather alerts for LATITUDE/LONGITUDE (free, no key needed).
INITIATIVE_WEATHER_ALERTS=true
# Quiet hours (local time): non-critical events stay silent between these.
INITIATIVE_QUIET_START=22
INITIATIVE_QUIET_END=7


# -----------------------------------------------------------------------------
# KILL SWITCH
# -----------------------------------------------------------------------------
# bcrypt hash of the password required to reset the kill switch.
# Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
KILL_SWITCH_PASSWORD_HASH=


# -----------------------------------------------------------------------------
# GOOGLE SERVICES (Phase 2)
# -----------------------------------------------------------------------------
# OAuth 2.0 client secrets JSON downloaded from Google Cloud Console.
# Set up at: https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Download the "Desktop app" OAuth client JSON and place it at this path.
GOOGLE_CLIENT_SECRETS_PATH=config_files/google_client_secrets.json

# Directory where per-user OAuth tokens are persisted between restarts.
# Created automatically on first authorization. Never commit this directory.
GOOGLE_TOKEN_STORAGE_PATH=data/google_tokens

# Google Maps Platform API key.
# Enable at: https://console.cloud.google.com/ -> APIs & Services -> Enable Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key


# -----------------------------------------------------------------------------
# HOME ASSISTANT (Phase 3)
# -----------------------------------------------------------------------------
# URL of your Home Assistant instance. LAN address preferred over cloud relay.
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Long-lived access token generated in HA: Profile -> Security -> Long-lived access tokens.
# Never commit this value. Treat it like a password.
HOME_ASSISTANT_TOKEN=your_long_lived_access_token

# Path to the device registry JSON file that maps plain-English names to HA entity IDs.
# Copy config_files/device_registry.example.json to this path and fill in your entities.
DEVICE_REGISTRY_PATH=config_files/device_registry.json

# ── Phase 2 Sidecars ──────────────────────────────────────────────────
PAPERLESS_URL=http://localhost:8010
PAPERLESS_TOKEN=
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=
FIREFLY_URL=http://localhost:8082
FIREFLY_TOKEN=
GROCY_URL=http://localhost:9283
GROCY_API_KEY=
TANDOOR_URL=http://localhost:8085
TANDOOR_TOKEN=
HOMEBOX_URL=http://localhost:7745
HOMEBOX_TOKEN=
UPLOAD_LOCATION=./infra/immich/upload

# ── Sidecar database passwords ────────────────────────────────────────
# Generate fresh values for each. None of these DBs publish a host port —
# they are only reachable from inside the Docker compose network — but
# defense-in-depth: don't ship weak defaults.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
PAPERLESS_DB_PASSWORD=
FIREFLY_DB_PASSWORD=
TANDOOR_DB_PASSWORD=
MEMGPT_DB_PASSWORD=

# -----------------------------------------------------------------------------
# INFORMATION FEEDS (Phase 5)
# -----------------------------------------------------------------------------

# OpenWeatherMap API key (free tier sufficient).
# Register at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key

# Default location for weather queries when no location is spoken.
# Format: "City,CountryCode" (e.g., "Chicago,US" or "London,GB")
DEFAULT_LOCATION=New York,US

# Temperature units for weather output: imperial (Fahrenheit) or metric (Celsius)
WEATHER_UNITS=imperial

# Geographical coordinates for weather, astronomy, and solar calculations
LOCATION_LAT=51.5074
LOCATION_LON=-0.1278

# NewsAPI.org key (free tier: 100 requests/day, headlines only in production).
# Register at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key

# Alpha Vantage key for stock quotes (free tier: 25 requests/day).
# Register at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# TheSportsDB API key. Free tier uses the literal value "1".
# Upgrade at: https://www.thesportsdb.com/api.php for more endpoints.
SPORTS_API_KEY=1

# ADS-B Exchange via RapidAPI
ADSBX_RAPIDAPI_KEY=

# PurpleAir
PURPLEAIR_API_KEY=

# Reddit (script-app credentials — read-only is fine)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RiverSongAI/1.0 by u/yourhandle

# Eventbrite OAuth (private token is fine for personal use)
EVENTBRITE_OAUTH_TOKEN=

# Hacker News, NOAA SWPC, Launch Library 2, NASA EONET, NASA NeoWs,
# and OCEARCH require no key. NeoWs has a higher quota with NASA_API_KEY.
NASA_API_KEY=DEMO_KEY




# -----------------------------------------------------------------------------
# STABLE DIFFUSION (IMAGE GENERATION)
# -----------------------------------------------------------------------------
SD_API_URL=http://localhost:7860
SD_ON_DEMAND=true
SD_EXECUTABLE_PATH=
SD_WORKING_DIR=

# -----------------------------------------------------------------------------
# CULINARY AI MODELS
# -----------------------------------------------------------------------------
CULINARY_LLM_MODEL=qwen2.5:3b
CULINARY_VISION_MODEL=gemma3:4b

# -----------------------------------------------------------------------------
# COMMERCE AUTOMATION (Phase 8)
# -----------------------------------------------------------------------------

# --- Amazon Selling Partner API (SP-API) ---
# Full setup guide: docs/api_registry/amazon_seller.txt
# Register your developer app at: https://developer.amazon.com/seller

# LWA (Login with Amazon) credentials -- from your developer app
AMAZON_SP_LWA_APP_ID=your_lwa_client_id
AMAZON_SP_LWA_CLIENT_SECRET=your_lwa_client_secret

# LWA refresh token -- generated when you authorize the app as a seller.
# Seller Central -> Apps & Services -> Manage Your Apps -> Authorize
AMAZON_SP_REFRESH_TOKEN=your_lwa_refresh_token

# AWS IAM credentials for SigV4 request signing
# Create an IAM user with AmazonSPAPISellerFull policy
AMAZON_AWS_ACCESS_KEY=your_aws_access_key
AMAZON_AWS_SECRET_KEY=your_aws_secret_key

# Your seller account ID (visible in Seller Central -> Account Info)
AMAZON_SELLER_ID=your_seller_id

# Marketplace ID. US default shown. Other regions: see docs/api_registry/amazon_seller.txt
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# Units at or below this count trigger a low-stock alert
AMAZON_LOW_STOCK_THRESHOLD=5


# --- Walmart Marketplace Seller API ---
# Full setup guide: docs/api_registry/walmart_seller.txt
# Register at: https://developer.walmart.com/

WALMART_CLIENT_ID=your_walmart_client_id
WALMART_CLIENT_SECRET=your_walmart_client_secret
WALMART_LOW_STOCK_THRESHOLD=5

# --- Shopify Store API ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=


# -----------------------------------------------------------------------------
# ANALYTICS PLATFORM INTEGRATIONS
# -----------------------------------------------------------------------------

# Analytics page is currently manual snapshot entry only. Real platform
# integrations for TikTok / Instagram / Facebook / YouTube / Etsy / eBay /
# Shopify / Pinterest / Twitter are tracked in docs/future_updates/roadmap.md
# and not implemented in code.

# Feature flag for AI-powered analytics summaries on the
# /api/analytics/{platform}/summary endpoint. Setting exists; wiring
# into the route is tracked in docs/KNOWN_ISSUES.md.
ANALYTICS_AI_ENABLED=true
ANALYTICS_LLM_MODEL=llama3



# -----------------------------------------------------------------------------
# READING PROVIDERS (Phase 6)
# -----------------------------------------------------------------------------

# Audible: base directory for per-user auth files ({user_id}.json).
# Run setup once per user: python -m providers.reading.audible --setup --user-id primary_user
# This directory is gitignored automatically (lives inside data/).
AUDIBLE_AUTH_BASE_PATH=data/audible

# Audible marketplace. Match this to the country where you bought your books.
# Options: us | uk | de | fr | es | it | jp | au | ca | in
AUDIBLE_COUNTRY_CODE=us

# Libby/OverDrive: base directory for per-user chip files ({user_id}.json).
# Run setup once per user: python -m providers.reading.libby --setup --user-id primary_user
# You will need the Libby app to generate an 8-digit pairing code.
# This directory is gitignored automatically (lives inside data/).
LIBBY_CHIP_BASE_PATH=data/libby


# -----------------------------------------------------------------------------
# MEMORY / DATABASE (Phase 1)
# -----------------------------------------------------------------------------

# Path to the SQLite database file. Created automatically on first run.
# Change this to an absolute path on your Linux machine if preferred.
DB_PATH=data/river_song.db

# Paths for the other SQLite databases (all live in data/ by default)
COMMERCE_DB_URL=sqlite:///./data/commerce.db
INVENTORY_DB_URL=sqlite:///./data/inventory.db
VEHICLES_DB_URL=sqlite:///./data/vehicles.db
MAIN_DB_PATH=./data/river_song.db

# Generate and store conversation summaries at the end of each session.
# Set to false to disable summaries entirely (facts and preferences still work).
MEMORY_SUMMARIES_ENABLED=true

# Default TTL for conversation summaries.
# Options: short (7 days) | standard (30 days) | extended (90 days) | long (365 days) | forever
MEMORY_DEFAULT_TTL=standard

# Automatically reset a summary's expiry from today each time it is referenced.
# Frequently-used summaries survive longer naturally under this rule.
MEMORY_AUTO_EXTEND=true

# Maximum number of recent summaries injected into the LLM context per turn.
MEMORY_MAX_SUMMARIES_IN_CONTEXT=10

# Semantic memory (Phase 1)
# Uses Ollama for embeddings and ChromaDB for vector storage.
# Set SEMANTIC_MEMORY_ENABLED=true and run: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
CHROMA_PATH=/mnt/data/river-song/chroma
SEMANTIC_MEMORY_ENABLED=true

# RAG (Retrieval-Augmented Generation) document settings.
# Defaults match the historical hardcoded values in providers/rag/chunker.py.
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# --- Reranking ---
# Vector search compares embeddings that were computed without ever seeing
# your question. A cross-encoder reads the question and the chunk together,
# so it ranks far better -- at the cost of running a second model.
# With this off, retrieval behaves exactly as it always has.
# Requires: pip install sentence-transformers
RAG_RERANK_ENABLED=false

# BAAI/bge-reranker-base      — light, comfortable on CPU (default)
# BAAI/bge-reranker-v2-m3     — stronger and multilingual, noticeably heavier
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# cpu | cuda | auto | cuda:1 …
# Defaults to cpu so reranking never competes with the LLM for VRAM.
RAG_RERANK_DEVICE=cpu

# How many chunks to pull before reranking, narrowed to RAG_TOP_K afterwards.
# Ignored when reranking is off. A bigger shortlist is where most of the
# remaining quality lives -- raise it when you have hardware to chew through it.
RAG_FETCH_K=25


# -----------------------------------------------------------------------------
# INTENT ROUTER (Phase 2+)
# -----------------------------------------------------------------------------
# Minimum confidence score (0.0 - 1.0) required to route to a Google provider.
# Below this threshold the transcript falls through to the Ollama conversation path.
INTENT_CONFIDENCE_THRESHOLD=0.7

# Default user ID used for Google OAuth token lookups.
# Must match the user_id passed to authorize_user() during initial OAuth flow.
DEFAULT_USER_ID=primary_user


# -----------------------------------------------------------------------------
# DAEMON INFRASTRUCTURE
# -----------------------------------------------------------------------------

# Shared secret used by daemons to authenticate their heartbeat and internal API calls.
# MUST be set in .env. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DAEMON_INTERNAL_SECRET=

# -----------------------------------------------------------------------------
# VOICE ID (SPEAKER RECOGNITION)
# -----------------------------------------------------------------------------
# Recognises WHO is speaking, so a shared device -- a Vortex hub on the
# kitchen counter -- works for a whole household instead of one login.
# Users enrol by reading a short script: GET /api/voice-id/enrollment-script

VOICE_ID_ENABLED=true

# Cosine similarity a voice must reach to be considered a match.
VOICE_ID_THRESHOLD=0.75

# Re-identify the speaker on every voice turn and switch to that user's
# memory and settings. Off by default -- it does nothing until household
# members have enrolled. An unrecognised speaker always falls back to the
# session user rather than being guessed at.
VOICE_ID_AUTO_IDENTIFY=false

# How far ahead of the runner-up a match must score to be trusted.
# Household members often sound alike and can BOTH clear the threshold above;
# this margin is what tells them apart.
#   River confusing two people?        raise it
#   River not recognising someone?     lower it
VOICE_ID_MIN_MARGIN=0.05

# -----------------------------------------------------------------------------
# Face match (enrolment sits beside voice match in a user's account)
# -----------------------------------------------------------------------------
# Fetch the two models once with:  python scripts/fetch_face_models.py
# Until then /api/face-id/status reports the feature as unavailable and says
# why. Face prints stay on this machine, under data/face_prints/<user_id>/.

# Offer face enrolment on the account page.
FACE_ID_ENABLED=true

# Cosine similarity above which two faces are the same person. 0.363 is
# SFace's published operating point. Raising it trades a locked-out household
# member for a marginal gain against someone already stood in the room.
FACE_ID_THRESHOLD=0.363

# Model paths. Empty uses data/models/face/, where the fetch script puts them.
FACE_ID_DETECTOR_MODEL=
FACE_ID_RECOGNIZER_MODEL=

# -----------------------------------------------------------------------------
# River Vortex (room hubs)
# -----------------------------------------------------------------------------
# Vortex units get their own per-unit token at pairing time — there is no
# shared device token to set here. These two are optional policy knobs.

# Fallback second factor for medium-risk actions confirmed on a Vortex
# touchscreen (opening a cover, switching the oven on). Used only when the
# unit's owner has no TOTP secret enrolled via /api/auth/2fa, which is the
# stronger option. It is typed on the screen and never spoken — a spoken PIN
# travels the same channel as the voice that triggered it. With neither this
# nor TOTP configured, medium-risk actions from a unit are refused.
VORTEX_CONFIRM_PIN=

# Dotted path to a face-matching callable, e.g. "mypackage.faces.match".
# Called with (image_bytes, owner_user_id) and returns
# {"user_id": ..., "confidence": 0.0-1.0}. Leave unset and this server reports
# "I can see someone, but I can't tell who" rather than guessing at a match.
# Face recognition is a second factor only; it never unlocks a door.
VORTEX_FACE_BACKEND=

# Path to a YuNet face-detection ONNX model. Empty uses the one
# scripts/fetch_face_models.py downloads. Without a model, face detection
# reports itself unavailable rather than reporting an empty room it never
# actually looked at.
VORTEX_FACE_DETECTOR_MODEL=

# WebRTC ICE servers for the intercom and video calls, as a JSON array:
#   [{"urls": "stun:stun.example.org:3478"},
#    {"urls": "turn:turn.example.org:3478", "username": "river",
#     "credential": "..."}]
# Empty is correct for two devices on the same LAN — they connect on host
# candidates alone. A phone on mobile data needs a TURN server here. Nothing
# is defaulted to a public STUN server: that would quietly send every
# household's IP to a third party. Call media never passes through this
# server either way — it only relays the signalling.
VORTEX_ICE_SERVERS=

# Hard kill switch for the code_interpreter LLM tool.
# When false, the tool refuses every call (no LLM, no code execution).
# When true, code_interpreter pins to your local Ollama instance — it will
# NEVER call a paid cloud API.
CODE_INTERPRETER_ENABLED=false

# Internal ports for background daemons. Bound to 127.0.0.1 exclusively.
DAEMON_WARDEN_PORT=8010
DAEMON_MECHANIC_PORT=8011
DAEMON_SIFTER_PORT=8013
DAEMON_NAVIGATOR_PORT=8014
DAEMON_CHEMIST_PORT=8015

# --- Warden (Security / Vision) ---
WARDEN_ENABLED=false
# JSON mapping of room names to RTSP camera streams.
WARDEN_RTSP_CAMERAS={"living_room": "", "kitchen": ""}
# YOLO object detection settings.
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.5
YOLO_INFERENCE_DEVICE=cpu

# --- Mechanic (ArduRover Telemetry) ---
MECHANIC_ENABLED=false
# Serial port for the MAVLink radio (e.g. /dev/ttyUSB0 or /dev/ttyACM0).
MAVLINK_SERIAL_PORT=/dev/ttyUSB0
MAVLINK_BAUD_RATE=57600

# --- Sifter (Background Document RAG) ---
SIFTER_ENABLED=false
# Absolute path to the directory where Sifter should look for documents to index.
WAPS_DOCUMENTS_PATH=/mnt/data/river-song/waps

# --- Observability: Langfuse (LLM tracing) ---
# Self-hosted Langfuse sidecar. See docs/LANGFUSE_INTEGRATION_PLAN.md.
# Bring up the container stack with:
#   docker compose --profile observability up -d
# Then visit http://127.0.0.1:3000, create a local account, generate keys,
# and paste them below before setting LANGFUSE_ENABLED=true.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=river-song
LANGFUSE_FLUSH_INTERVAL_SECONDS=5

# Langfuse infrastructure passwords (compose-only — Python settings above
# use the Langfuse API keys generated inside the Langfuse UI on first run).
LANGFUSE_DB_PASSWORD=
# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
# Generate with: openssl rand -base64 32
LANGFUSE_SALT=

# --- Observability: Graphiti (knowledge graph on Neo4j) ---
# See docs/GRAPHITI_INTEGRATION_PLAN.md. Library-mode (Option B):
# Graphiti runs inside RiverSong's Python venv; only Neo4j is a sidecar.
GRAPHITI_ENABLED=false
GRAPHITI_MODE=library
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_BROWSER_URL=http://127.0.0.1:7474
# Graphiti's entity-extraction LLM — local-first. Points at Ollama's
# OpenAI-compatible /v1 endpoint so episode ingestion never bills a cloud API.
GRAPHITI_LLM_MODEL=llama3.2:3b
GRAPHITI_LLM_BASE_URL=http://localhost:11434/v1
GRAPHITI_EMBEDDER_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# ADDITIONAL CAPABILITY FLAGS
# -----------------------------------------------------------------------------
# These flags control specific features and capabilities within River Song.
# Default values are shown below.

# IMPORTANT: CSRF protection must be enabled in production.
CSRF_PROTECTION_ENABLED=true

NVIDIA_NIM_ENABLED=false
HABIT_INFERENCE_ENABLED=false
RAG_ENABLED=false
IMAGE_GENERATION_ENABLED=false
CHATTERBOX_ENABLED=false
KILLSWITCH_PUSH_ENABLED=false
NTFY_ENABLED=false
FCM_ENABLED=false
N8N_ENABLED=false
MODEL_INTENT_ROUTER_ENABLED=false
DAEMON_PULSE_ENABLED=true
DAEMON_SCRIBE_ENABLED=false
HARDWARE_COOKBOOK_ENABLED=false
DOCUMENTS_ENABLED=true
SKILLS_ENABLED=true
GMAIL_TRIAGE_ENABLED=false
SESSION_PRESETS_ENABLED=true
DEEP_RESEARCH_ENABLED=true
BLIND_COMPARE_ENABLED=false
PLAYWRIGHT_BROWSER_ENABLED=false
# Local wake word detection (openWakeWord). AdminWakeWordSection in Settings
# configures the model and threshold but cannot switch the subsystem on -- this
# is the master switch it does not expose.
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL=hey_river

# --- Python Runtime Compatibility Flags ---
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1
