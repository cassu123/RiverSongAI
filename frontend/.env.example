# =============================================================================
# River Song — FRONTEND environment
# =============================================================================
#
# These are SEPARATE from the backend .env in the repo root.
#
#   Repo root  /.env            → backend: models, voices, daemons, keys
#   Here       /frontend/.env   → browser UI only
#
# Only variables prefixed VITE_ reach the browser, and they are baked in at
# BUILD time, not read at runtime. Change one and you must rebuild:
#
#     cd frontend && npm run build
#
# WARNING: anything here ships to the browser in plain text. Never put an API
# key, token, or secret in this file -- they belong in the backend .env.
#
# Copy to .env (local dev) or .env.production (deployed build).
# =============================================================================

# Where the browser reaches the River Song backend.
VITE_API_URL=https://riversongai.com


# -----------------------------------------------------------------------------
# AVATAR
# -----------------------------------------------------------------------------

# Use the 3D VRM avatar instead of the orb. Defaults to true.
# The avatar falls back to the orb on its own when no model is installed, so
# leaving this on is safe with an empty models folder. Set false to force the
# orb even when a model IS present -- useful on low-powered hub screens.
VITE_RIVER_USE_AVATAR=true

# Which VRM model to load. Must be under frontend/public/.
# See frontend/public/models/README.md for where to get free rigged models.
VITE_RIVER_AVATAR_URL=/models/river.vrm
